{
  "name": "comem",
  "description": "Durable hierarchical memory tree plugin for DeepSeek Harness",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "version": "0.3.2",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.ts && tsdown --config-loader unrun --config tsdown.client.config.ts",
    "fmt": "oxfmt --config .oxfmtrc.json --write src tests",
    "fmt:check": "oxfmt --config .oxfmtrc.json --check src tests",
    "lint": "oxlint --config .oxlintrc.json --type-check --deny-warnings src tests",
    "lint:fix": "oxlint --config .oxlintrc.json --type-check --deny-warnings --fix src tests",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.3-alpha.1",
    "cordis": "^4.0.0-rc.7",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@cordisjs/plugin-loader": "^1.0.0-rc.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "cordis": "^4.0.0-rc.7",
    "oxfmt": "0.64.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^18.3.1",
    "schemastery": "^3.18.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  }
}
